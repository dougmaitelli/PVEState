#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

load_env() {
  if [[ -f "${repo_dir}/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${repo_dir}/.env"
    set +a
  fi
}

usage() {
  cat <<'EOF'
Usage: ./bin/iac <command>

Commands:
  setup      Create/update the project-local Python environment
  doctor     Validate local tooling and discovery credentials
  check      Validate desired configuration and cross-file references
  discover   Collect a read-only snapshot from the PVE API
  capture    Refresh all read-only production observations and exports
  pbs-doctor Validate local PBS discovery credentials
  pbs-discover
             Collect a read-only snapshot from the PBS API
  host-discover
             Collect approved read-only PVE host and PBS guest metadata over SSH
  guest-discover
             Collect approved read-only service metadata from existing guests
  audit      Build an offline recovery-readiness report from latest snapshots
  export-config
             Export allowlisted, sanitized PVE/PBS configuration over SSH
  plan       Compare all managed desired configuration with production
  save MESSAGE
             Commit reviewed desired configuration and sanitized exports locally
  apply      Apply an exact, fresh plan with separate mutation credentials
  rebuild-plan TARGET
             Validate recovery inputs and create a confirmation-ready plan
  bootstrap-pve TARGET
             Configure a replacement PVE host (guarded mutation)
  bootstrap-pbs TARGET
             Create the replacement PBS LXC (guarded mutation)
  restore-guests TARGET
             Restore reviewed guest archives (guarded mutation)
  configure TARGET
             Run the reviewed application configuration handoff
  rebuild TARGET
             Run all guarded recovery stages in order
  validate   Run read-only service recovery checks
  help       Show this message

Delete, guest replacement, disk shrinking, and implicit storage moves are forbidden.
EOF
}

require_project_python() {
  if [[ ! -x "${repo_dir}/.venv/bin/python" ]]; then
    echo "Project environment is missing. Run: ./bin/iac setup" >&2
    exit 1
  fi
}

setup() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 is required to set up this repository." >&2
    exit 1
  fi

  if [[ ! -x "${repo_dir}/.venv/bin/python" ]]; then
    python3 -m venv "${repo_dir}/.venv"
  fi

  "${repo_dir}/.venv/bin/python" -m pip install -r "${repo_dir}/requirements.txt"
  "${repo_dir}/.venv/bin/ansible-galaxy" collection install \
    -r "${repo_dir}/ansible/requirements.yml" \
    -p "${repo_dir}/ansible/collections"

  echo "Setup complete. No virtualenv activation is needed; use ./bin/iac commands directly."
}

doctor() {
  load_env
  local failed=0

  command -v python3 >/dev/null || { echo "missing: python3" >&2; failed=1; }
  [[ -n "${PVE_ENDPOINT:-}" ]] || { echo "missing: PVE_ENDPOINT" >&2; failed=1; }
  [[ -n "${PVE_API_TOKEN_ID:-}" ]] || { echo "missing: PVE_API_TOKEN_ID" >&2; failed=1; }
  [[ -n "${PVE_API_TOKEN_SECRET:-}" ]] || { echo "missing: PVE_API_TOKEN_SECRET" >&2; failed=1; }

  if [[ "${PVE_VERIFY_TLS:-true}" != "true" ]]; then
    echo "warning: TLS verification is disabled" >&2
  fi

  if (( failed )); then
    echo "doctor: configuration incomplete; copy .env.example to .env" >&2
    return 2
  fi

  echo "doctor: local configuration is ready"
}

pbs_doctor() {
  load_env
  local failed=0

  command -v python3 >/dev/null || { echo "missing: python3" >&2; failed=1; }
  [[ -n "${PBS_ENDPOINT:-}" ]] || { echo "missing: PBS_ENDPOINT" >&2; failed=1; }
  [[ -n "${PBS_API_TOKEN_ID:-}" ]] || { echo "missing: PBS_API_TOKEN_ID" >&2; failed=1; }
  [[ -n "${PBS_API_TOKEN_SECRET:-}" ]] || { echo "missing: PBS_API_TOKEN_SECRET" >&2; failed=1; }

  if [[ "${PBS_VERIFY_TLS:-true}" != "true" ]]; then
    echo "warning: PBS TLS verification is disabled" >&2
  fi

  if (( failed )); then
    echo "pbs-doctor: configuration incomplete" >&2
    return 2
  fi

  echo "pbs-doctor: local configuration is ready"
}

discover() {
  doctor >/dev/null
  python3 "${repo_dir}/scripts/pve_discover.py" \
    --output-dir "${repo_dir}/artifacts/discovery"
}

pbs_discover() {
  pbs_doctor >/dev/null
  python3 "${repo_dir}/scripts/pbs_discover.py" \
    --output-dir "${repo_dir}/artifacts/discovery"
}

host_discover() {
  python3 "${repo_dir}/scripts/host_discover.py" \
    --host "${PVE_SSH_HOST:-pve.h4des.dev}" \
    --port "${PVE_SSH_PORT:-22}" \
    --identity "${repo_dir}/.secrets/pve_discovery" \
    --known-hosts "${repo_dir}/.secrets/known_hosts" \
    --output-dir "${repo_dir}/artifacts/discovery"
}

guest_discover() {
  python3 "${repo_dir}/scripts/guest_discover.py" \
    --host "${PVE_SSH_HOST:-pve.h4des.dev}" \
    --port "${PVE_SSH_PORT:-22}" \
    --identity "${repo_dir}/.secrets/pve_discovery" \
    --known-hosts "${repo_dir}/.secrets/known_hosts" \
    --output-dir "${repo_dir}/artifacts/discovery"
}

audit() {
  python3 "${repo_dir}/scripts/recovery_audit.py" \
    --discovery-dir "${repo_dir}/artifacts/discovery" \
    --output "${repo_dir}/artifacts/recovery-audit.md"
}

export_config() {
  python3 "${repo_dir}/scripts/export_safe_configs.py" \
    --host "${PVE_SSH_HOST:-pve.h4des.dev}" \
    --port "${PVE_SSH_PORT:-22}" \
    --identity "${repo_dir}/.secrets/pve_discovery" \
    --known-hosts "${repo_dir}/.secrets/known_hosts" \
    --output-dir "${repo_dir}/exports/production"
}

ansible_playbook() {
  require_project_python
  ANSIBLE_CONFIG="${repo_dir}/ansible/ansible.cfg" \
  ANSIBLE_COLLECTIONS_PATH="${repo_dir}/ansible/collections" \
    "${repo_dir}/.venv/bin/ansible-playbook" "$@"
}

plan_infrastructure() {
  load_env
  doctor >/dev/null
  require_project_python
  "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/validate_config.py" --config-dir "${repo_dir}/config"
  "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/production_plan.py" \
    --root "${repo_dir}" --output "${repo_dir}/artifacts/production-plan.json"
}

apply_infrastructure() {
  load_env
  require_project_python
  "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/production_apply.py" \
    --plan "${repo_dir}/artifacts/production-plan.json"
}

capture_production() {
  load_env
  discover
  host_discover
  guest_discover
  export_config
  pbs_discover
}

save_config() {
  local message="${1:?usage: ./bin/iac save MESSAGE}"
  if [[ ! -d "${repo_dir}/.git" ]]; then
    git -C "${repo_dir}" init
    git -C "${repo_dir}" config user.name "h4des IaC operator"
    git -C "${repo_dir}" config user.email "iac@h4des.local"
  fi
  git -C "${repo_dir}" add .gitignore .env.example README.md requirements.txt bin config docs exports scripts templates ansible artifacts/discovery/.gitkeep
  git -C "${repo_dir}" diff --cached --check -- . ':(exclude)exports/**'
  git -C "${repo_dir}" commit -m "${message}"
}

validate_services() {
  require_project_python
  "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/validate_services.py" \
    --checks "${repo_dir}/config/recovery-checks.yml" \
    --host "${PVE_SSH_HOST:-pve.h4des.dev}" \
    --port "${PVE_SSH_PORT:-22}" \
    --identity "${repo_dir}/.secrets/pve_discovery" \
    --known-hosts "${repo_dir}/.secrets/known_hosts" \
    --json-output "${repo_dir}/artifacts/service-validation.json" \
    --markdown-output "${repo_dir}/artifacts/service-validation.md"
}

rebuild_plan() {
  require_project_python
  local target="${1:?usage: ./bin/iac rebuild-plan TARGET}"
  "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/rebuild_plan.py" \
    --config-dir "${repo_dir}/config" \
    --target "${target}" \
    --output "${repo_dir}/artifacts/rebuild-plan.json"
}

run_rebuild_stage() {
  require_project_python
  local stage="$1"
  local target="${2:?usage: ./bin/iac ${stage} TARGET}"
  local plan="${repo_dir}/artifacts/rebuild-plan.json"
  [[ -f "${plan}" ]] || { echo "missing rebuild plan; run ./bin/iac rebuild-plan ${target}" >&2; exit 1; }
  "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/authorize_rebuild.py" \
    --plan "${plan}" --restore-config "${repo_dir}/config/restore.yml" \
    --target "${target}" --stage "${stage}"
  local ssh_args=()
  if [[ -n "${IAC_TARGET_SSH_KEY:-}" ]]; then
    ssh_args+=(--private-key "${IAC_TARGET_SSH_KEY}")
  fi
  ansible_playbook -i "${target}," -u "${IAC_TARGET_SSH_USER:-root}" \
    "${ssh_args[@]}" "${repo_dir}/ansible/playbooks/${stage}.yml" \
    -e "iac_commit_network=${IAC_COMMIT_NETWORK:-false}"
}

case "${1:-help}" in
  setup) setup ;;
  doctor) doctor ;;
  check) require_project_python; "${repo_dir}/.venv/bin/python" "${repo_dir}/scripts/validate_config.py" --config-dir "${repo_dir}/config" ;;
  discover) load_env; discover ;;
  capture) capture_production ;;
  pbs-doctor) pbs_doctor ;;
  pbs-discover) load_env; pbs_discover ;;
  host-discover) load_env; host_discover ;;
  guest-discover) load_env; guest_discover ;;
  audit) audit ;;
  export-config) load_env; export_config ;;
  plan) plan_infrastructure ;;
  save) save_config "${2:-}" ;;
  apply) apply_infrastructure ;;
  rebuild-plan) rebuild_plan "${2:-}" ;;
  bootstrap-pve|bootstrap-pbs|restore-guests|configure|rebuild)
    run_rebuild_stage "$1" "${2:-}"
    ;;
  validate) load_env; validate_services ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FirewallConfig",
  "type": "object",
  "properties": {
    "absent_guest_files": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    },
    "cluster": {
      "$ref": "#/$defs/FirewallPolicy"
    },
    "guests": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/FirewallPolicy"
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/NodeFirewall"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cluster",
    "nodes",
    "guests",
    "absent_guest_files"
  ],
  "$defs": {
    "FirewallPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "log_level_in": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "rules"
      ]
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination_port": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "type": [
            "string",
            "null"
          ]
        },
        "log": {
          "type": "string"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "action",
        "log"
      ]
    },
    "NodeFirewall": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "present",
        "rules"
      ]
    }
  }
}

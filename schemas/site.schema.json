{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SiteConfig",
  "type": "object",
  "properties": {
    "backup": {
      "$ref": "#/$defs/SiteBackup"
    },
    "proxmox": {
      "$ref": "#/$defs/ProxmoxSite"
    },
    "site": {
      "$ref": "#/$defs/SiteIdentity"
    },
    "workload_profile": {
      "$ref": "#/$defs/WorkloadProfile"
    }
  },
  "additionalProperties": false,
  "required": [
    "site",
    "proxmox",
    "workload_profile",
    "backup"
  ],
  "$defs": {
    "Count": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ]
    },
    "ProxmoxSite": {
      "type": "object",
      "properties": {
        "change_policy": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "existing_environment": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "existing_environment",
        "change_policy"
      ]
    },
    "SiteBackup": {
      "type": "object",
      "properties": {
        "pbs": {
          "$ref": "#/$defs/SitePbs"
        },
        "s3": {
          "$ref": "#/$defs/SiteS3"
        }
      },
      "additionalProperties": false,
      "required": [
        "pbs",
        "s3"
      ]
    },
    "SiteIdentity": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "environment"
      ]
    },
    "SitePbs": {
      "type": "object",
      "properties": {
        "deployment": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "deployment",
        "endpoint"
      ]
    },
    "SiteS3": {
      "type": "object",
      "properties": {
        "configured_in_pbs": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "configured_in_pbs",
        "endpoint"
      ]
    },
    "WorkloadProfile": {
      "type": "object",
      "properties": {
        "containers": {
          "$ref": "#/$defs/Count"
        },
        "virtual_machines": {
          "$ref": "#/$defs/Count"
        }
      },
      "additionalProperties": false,
      "required": [
        "virtual_machines",
        "containers"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeConfig",
  "type": "object",
  "properties": {
    "firewall": {
      "anyOf": [
        {
          "$ref": "#/$defs/FirewallPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "node": {
      "$ref": "#/$defs/NodeIdentity"
    },
    "storage_topology": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/StorageTopology"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "node",
    "storage_topology"
  ],
  "$defs": {
    "FirewallAction": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "DROP",
        "REJECT",
        "RETURN"
      ]
    },
    "FirewallAlias": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "network"
      ]
    },
    "FirewallDirection": {
      "type": "string",
      "enum": [
        "IN",
        "OUT",
        "GROUP"
      ]
    },
    "FirewallIpSet": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallIpSetEntry"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "FirewallIpSetEntry": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "network": {
          "type": "string"
        },
        "nomatch": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "network"
      ]
    },
    "FirewallLogLevel": {
      "type": "string",
      "enum": [
        "nolog",
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug"
      ]
    },
    "FirewallPolicy": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallAlias"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "ip_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallIpSet"
          }
        },
        "log_level_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallLogLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        },
        "security_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallSecurityGroup"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "FirewallProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp",
        "icmpv6",
        "esp",
        "ah"
      ]
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/FirewallAction"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "direction": {
          "$ref": "#/$defs/FirewallDirection"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "log": {
          "$ref": "#/$defs/FirewallLogLevel",
          "default": "nolog"
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallProtocol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "action"
      ]
    },
    "FirewallSecurityGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "NodeIdentity": {
      "type": "object",
      "properties": {
        "kernel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pve_version": {
          "type": "string"
        },
        "standalone": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "standalone",
        "pve_version",
        "kernel"
      ]
    },
    "StorageTopology": {
      "type": "object",
      "properties": {
        "consumers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "device_class": {
          "type": "string"
        },
        "devices": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout": {
          "type": [
            "string",
            "null"
          ]
        },
        "mount": {
          "type": [
            "string",
            "null"
          ]
        },
        "provides": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "redundancy": {
          "type": "string"
        },
        "size_tb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "redundancy",
        "device_class"
      ]
    }
  }
}

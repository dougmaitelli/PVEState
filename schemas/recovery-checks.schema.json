      }
    }
  },
  "additionalProperties": false,
  "required": [
    "checks"
  ],
  "$defs": {
    "RecoveryCheck": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "command"
      ]
    }
  }
}

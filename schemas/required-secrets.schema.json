{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequiredSecretsConfig",
  "type": "object",
  "properties": {
    "never_commit": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_for_disaster_recovery": {
      "$ref": "#/$defs/SecretGroups"
    }
  },
  "additionalProperties": false,
  "required": [
    "required_for_disaster_recovery",
    "never_commit"
  ],
  "$defs": {
    "SecretGroups": {
      "type": "object",
      "properties": {
        "application": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pbs_identity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pbs_s3": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pve_to_pbs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "pbs_s3",
        "pbs_identity",
        "pve_to_pbs",
        "application"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackupConfig",
  "type": "object",
  "properties": {
    "absent_pve_backup_jobs": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "pbs": {
      "$ref": "#/$defs/PbsBackup"
    },
    "pve_backup_jobs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/PveBackupJob"
      },
      "default": {}
    }
  },
  "additionalProperties": false,
  "required": [
    "pbs"
  ],
  "$defs": {
    "BackupGuest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "vmid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "vmid"
      ]
    },
    "BackupJobs": {
      "type": "object",
      "properties": {
        "absent_prune": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "absent_sync": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "absent_verify": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "prune": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PruneJob"
          },
          "default": {}
        },
        "sync": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SyncJob"
          },
          "default": {}
        },
        "verify": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VerifyJob"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "Datastore": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "garbage_collection_schedule": {
          "type": "string"
        },
        "local_cache_path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "s3_endpoint_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "backend",
        "local_cache_path",
        "bucket",
        "s3_endpoint_id",
        "garbage_collection_schedule"
      ]
    },
    "PbsBackup": {
      "type": "object",
      "properties": {
        "datastore": {
          "$ref": "#/$defs/Datastore"
        },
        "endpoint": {
          "type": "string"
        },
        "guest": {
          "$ref": "#/$defs/BackupGuest"
        },
        "jobs": {
          "$ref": "#/$defs/BackupJobs"
        },
        "s3_endpoint": {
          "$ref": "#/$defs/S3Endpoint"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "version",
        "guest",
        "datastore",
        "s3_endpoint",
        "jobs"
      ]
    },
    "PruneJob": {
      "type": "object",
      "properties": {
        "keep_last": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "schedule": {
          "type": "string"
        },
        "store": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "store",
        "schedule"
      ]
    },
    "PveBackupJob": {
      "type": "object",
      "properties": {
        "guest_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "mode": {
          "type": "string"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "schedule": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage",
        "schedule",
        "mode",
        "guest_ids",
        "retention"
      ]
    },
    "Retention": {
      "type": "object",
      "properties": {
        "keep_last": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "keep_last"
      ]
    },
    "S3Endpoint": {
      "type": "object",
      "properties": {
        "endpoint_template": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "endpoint_template",
        "region"
      ]
    },
    "SyncJob": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "default": "pull"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "remote_store": {
          "type": "string"
        },
        "remove_vanished": {
          "type": "boolean",
          "default": false
        },
        "schedule": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "store": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "store",
        "remote_store"
      ]
    },
    "VerifyJob": {
      "type": "object",
      "properties": {
        "ignore_verified": {
          "type": "boolean"
        },
        "outdated_after_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "schedule": {
          "type": "string"
        },
        "store": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "store",
        "schedule",
        "ignore_verified",
        "outdated_after_days"
      ]
    }
  }
}

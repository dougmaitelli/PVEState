{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClusterConfig",
  "type": "object",
  "properties": {
    "backup": {
      "$ref": "#/$defs/ClusterBackup"
    },
    "cluster": {
      "$ref": "#/$defs/ClusterIdentity"
    },
    "firewall": {
      "anyOf": [
        {
          "$ref": "#/$defs/FirewallPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proxmox": {
      "$ref": "#/$defs/ProxmoxCluster"
    },
    "workload_profile": {
      "$ref": "#/$defs/WorkloadProfile"
    }
  },
  "additionalProperties": false,
  "required": [
    "cluster",
    "proxmox",
    "workload_profile",
    "backup"
  ],
  "$defs": {
    "ClusterBackup": {
      "type": "object",
      "properties": {
        "pbs": {
          "$ref": "#/$defs/ClusterPbs"
        },
        "s3": {
          "$ref": "#/$defs/ClusterS3"
        }
      },
      "additionalProperties": false,
      "required": [
        "pbs",
        "s3"
      ]
    },
    "ClusterIdentity": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "environment"
      ]
    },
    "ClusterPbs": {
      "type": "object",
      "properties": {
        "deployment": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "deployment",
        "endpoint"
      ]
    },
    "ClusterS3": {
      "type": "object",
      "properties": {
        "configured_in_pbs": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "configured_in_pbs",
        "endpoint"
      ]
    },
    "Count": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ]
    },
    "FirewallAction": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "DROP",
        "REJECT",
        "RETURN"
      ]
    },
    "FirewallAlias": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "network"
      ]
    },
    "FirewallDirection": {
      "type": "string",
      "enum": [
        "IN",
        "OUT",
        "GROUP"
      ]
    },
    "FirewallIpSet": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallIpSetEntry"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "FirewallIpSetEntry": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "network": {
          "type": "string"
        },
        "nomatch": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "network"
      ]
    },
    "FirewallLogLevel": {
      "type": "string",
      "enum": [
        "nolog",
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug"
      ]
    },
    "FirewallPolicy": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallAlias"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "ip_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallIpSet"
          }
        },
        "log_level_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallLogLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        },
        "security_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallSecurityGroup"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "FirewallProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp",
        "icmpv6",
        "esp",
        "ah"
      ]
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/FirewallAction"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "direction": {
          "$ref": "#/$defs/FirewallDirection"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "log": {
          "$ref": "#/$defs/FirewallLogLevel",
          "default": "nolog"
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallProtocol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "action"
      ]
    },
    "FirewallSecurityGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ProxmoxCluster": {
      "type": "object",
      "properties": {
        "change_policy": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "existing_environment": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "existing_environment",
        "change_policy"
      ]
    },
    "WorkloadProfile": {
      "type": "object",
      "properties": {
        "containers": {
          "$ref": "#/$defs/Count"
        },
        "virtual_machines": {
          "$ref": "#/$defs/Count"
        }
      },
      "additionalProperties": false,
      "required": [
        "virtual_machines",
        "containers"
      ]
    }
  }
}

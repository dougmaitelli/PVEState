{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guests",
  "type": "object",
  "properties": {
    "lxcs": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/Lxc"
        }
      }
    },
    "node": {
      "type": "string"
    },
    "vms": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/Vm"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "node"
  ],
  "$defs": {
    "BindMount": {
      "type": "object",
      "properties": {
        "backed_up_by_pve": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "backed_up_by_pve"
      ]
    },
    "Cpu": {
      "type": "object",
      "properties": {
        "cores": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sockets": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "sockets",
        "cores"
      ]
    },
    "Disk": {
      "type": "object",
      "properties": {
        "size_gb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage",
        "size_gb"
      ]
    },
    "Efi": {
      "type": "object",
      "properties": {
        "pre_enrolled_keys": {
          "type": "boolean"
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage",
        "pre_enrolled_keys"
      ]
    },
    "FirewallAction": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "DROP",
        "REJECT",
        "RETURN"
      ]
    },
    "FirewallAlias": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "network"
      ]
    },
    "FirewallDirection": {
      "type": "string",
      "enum": [
        "IN",
        "OUT",
        "GROUP"
      ]
    },
    "FirewallIpSet": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallIpSetEntry"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "FirewallIpSetEntry": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "network": {
          "type": "string"
        },
        "nomatch": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "network"
      ]
    },
    "FirewallLogLevel": {
      "type": "string",
      "enum": [
        "nolog",
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug"
      ]
    },
    "FirewallPolicy": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallAlias"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "ip_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallIpSet"
          }
        },
        "log_level_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallLogLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        },
        "security_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallSecurityGroup"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "FirewallProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp",
        "icmpv6",
        "esp",
        "ah"
      ]
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/FirewallAction"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "direction": {
          "$ref": "#/$defs/FirewallDirection"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "log": {
          "$ref": "#/$defs/FirewallLogLevel",
          "default": "nolog"
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallProtocol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "action"
      ]
    },
    "FirewallSecurityGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Lxc": {
      "type": "object",
      "properties": {
        "bind_mounts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BindMount"
          }
        },
        "cores": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "firewall": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hostname": {
          "type": "string"
        },
        "memory_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "networks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Nic"
          }
        },
        "options": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "os": {
          "type": "string"
        },
        "rootfs": {
          "$ref": "#/$defs/Disk"
        },
        "start": {
          "$ref": "#/$defs/Start"
        },
        "swap_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unprivileged": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "hostname",
        "os",
        "unprivileged",
        "cores",
        "memory_mb",
        "swap_mb",
        "rootfs",
        "start"
      ]
    },
    "Nic": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "string"
        },
        "firewall": {
          "type": "boolean",
          "default": false
        },
        "gateway4": {
          "type": [
            "string",
            "null"
          ]
        },
        "gateway6": {
          "type": [
            "string",
            "null"
          ]
        },
        "ipv4": {
          "type": "string"
        },
        "ipv6": {
          "type": [
            "string",
            "null"
          ]
        },
        "mac": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "mac",
        "bridge",
        "ipv4"
      ]
    },
    "Start": {
      "type": "object",
      "properties": {
        "delay_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "onboot": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "onboot",
        "order"
      ]
    },
    "Usb": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host"
      ]
    },
    "Vm": {
      "type": "object",
      "properties": {
        "bios": {
          "type": "string"
        },
        "cpu": {
          "$ref": "#/$defs/Cpu"
        },
        "disks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VmDisk"
          }
        },
        "efi_disks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Efi"
          }
        },
        "firewall": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "machine": {
          "type": "string"
        },
        "memory_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "networks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VmNic"
          }
        },
        "qemu_guest_agent": {
          "type": "boolean"
        },
        "start": {
          "$ref": "#/$defs/Start"
        },
        "usb_devices": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Usb"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "machine",
        "bios",
        "cpu",
        "memory_mb",
        "disks",
        "efi_disks",
        "networks",
        "usb_devices",
        "qemu_guest_agent",
        "start"
      ]
    },
    "VmDisk": {
      "type": "object",
      "properties": {
        "discard": {
          "type": "boolean",
          "default": false
        },
        "size_gb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage",
        "size_gb"
      ]
    },
    "VmNic": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "string"
        },
        "firewall": {
          "type": "boolean",
          "default": false
        },
        "mac": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "vlan": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "model",
        "mac",
        "bridge"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodeConfig",
  "type": "object",
  "properties": {
    "firewall": {
      "anyOf": [
        {
          "$ref": "#/$defs/FirewallPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "node": {
      "$ref": "#/$defs/NodeIdentity"
    },
    "storage_topology": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/StorageTopology"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "node",
    "storage_topology"
  ],
  "$defs": {
    "FirewallPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "log_level_in": {
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "rules"
      ]
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "destination_port": {
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "type": [
            "string",
            "null"
          ]
        },
        "log": {
          "type": "string"
        },
        "protocol": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "action",
        "log"
      ]
    },
    "NodeIdentity": {
      "type": "object",
      "properties": {
        "kernel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pve_version": {
          "type": "string"
        },
        "standalone": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "standalone",
        "pve_version",
        "kernel"
      ]
    },
    "StorageTopology": {
      "type": "object",
      "properties": {
        "consumers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "device_class": {
          "type": "string"
        },
        "devices": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "layout": {
          "type": [
            "string",
            "null"
          ]
        },
        "mount": {
          "type": [
            "string",
            "null"
          ]
        },
        "provides": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "redundancy": {
          "type": "string"
        },
        "size_tb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "redundancy",
        "device_class"
      ]
    }
  }
}

[OPTIONS]

enable: 1
log_level_in: nolog

[RULES]

IN ACCEPT -i net2 -log nolog
IN ACCEPT -p tcp -dport 8095:8097 -log nolog # Music Assistant
IN ACCEPT -p tcp -dport 57621,57622 -log nolog # Spotify Connect
IN ACCEPT -p udp -dport 5353 -log nolog # Spotify Connect
|IN ACCEPT -p udp -dport 4001,4002 -log nolog # Govee


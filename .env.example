# Copy to .env, chmod 600 .env, and fill in the token values.
# Never commit the resulting file.
PVE_ENDPOINT=https://pve.h4des.dev:8006
PVE_API_TOKEN_ID=iac-auditor@pve!discovery
PVE_API_TOKEN_SECRET=replace-me

# Keep certificate verification enabled. If PVE uses a private CA, set its PEM path.
PVE_VERIFY_TLS=true
# PVE_CA_FILE=/absolute/path/to/private-ca.pem

# PBS is intentionally deferred until its URL and access model are known.
# PBS_ENDPOINT=https://pbs.example.test:8007
# PBS_API_TOKEN_ID=iac-auditor@pbs!discovery
# PBS_API_TOKEN_SECRET=replace-me
# PBS_VERIFY_TLS=true
# PBS_CA_FILE=/absolute/path/to/private-ca.pem
# Production apply uses a separate, narrowly scoped mutation identity. Never
# reuse the audit-only discovery token or key for these values.
PVE_APPLY_ENDPOINT=https://pve.h4des.dev:8006
PVE_APPLY_API_TOKEN_ID=
PVE_APPLY_API_TOKEN_SECRET=
IAC_APPLY_SSH_HOST=pve.h4des.dev
IAC_APPLY_SSH_PORT=22
IAC_APPLY_SSH_USER=root
IAC_APPLY_SSH_KEY=
IAC_APPLY_KNOWN_HOSTS=

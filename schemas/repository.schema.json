{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryDocument",
  "type": "object",
  "properties": {
    "backup": {
      "$ref": "#/$defs/BackupConfig"
    },
    "cluster": {
      "$ref": "#/$defs/ClusterConfig"
    },
    "guests": {
      "$ref": "#/$defs/Guests"
    },
    "network": {
      "$ref": "#/$defs/Network"
    },
    "node": {
      "$ref": "#/$defs/NodeConfig"
    },
    "pves": {
      "$ref": "#/$defs/RepositoryManifest"
    },
    "recovery_checks": {
      "$ref": "#/$defs/RecoveryChecks"
    },
    "required_secrets": {
      "$ref": "#/$defs/RequiredSecretsConfig"
    },
    "restore": {
      "$ref": "#/$defs/RestoreConfig"
    },
    "services": {
      "$ref": "#/$defs/ServicesConfig"
    },
    "storage": {
      "$ref": "#/$defs/StorageConfig"
    }
  },
  "additionalProperties": false,
  "required": [
    "pves",
    "cluster",
    "node",
    "guests",
    "network",
    "storage",
    "backup",
    "restore",
    "recovery_checks",
    "services",
    "required_secrets"
  ],
  "$defs": {
    "AddressMethod": {
      "type": "string",
      "enum": [
        "manual",
        "static",
        "dhcp"
      ]
    },
    "BackupConfig": {
      "type": "object",
      "properties": {
        "absent_pve_backup_jobs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "pbs": {
          "$ref": "#/$defs/PbsBackup"
        },
        "pve_backup_jobs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PveBackupJob"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "pbs"
      ]
    },
    "BackupGuest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "vmid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "vmid"
      ]
    },
    "BackupJobs": {
      "type": "object",
      "properties": {
        "absent_prune": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "absent_sync": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "absent_verify": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "prune": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PruneJob"
          },
          "default": {}
        },
        "sync": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SyncJob"
          },
          "default": {}
        },
        "verify": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VerifyJob"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "BackupMode": {
      "type": "string",
      "enum": [
        "snapshot",
        "suspend",
        "stop"
      ]
    },
    "BindMount": {
      "type": "object",
      "properties": {
        "backed_up_by_pve": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "backed_up_by_pve"
      ]
    },
    "Bridge": {
      "type": "object",
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "forward_delay": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ]
        },
        "gateway6": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "ipv6": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "method": {
          "$ref": "#/$defs/AddressMethod"
        },
        "name": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "stp": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "method",
        "stp",
        "forward_delay"
      ]
    },
    "ClusterBackup": {
      "type": "object",
      "properties": {
        "pbs": {
          "$ref": "#/$defs/ClusterPbs"
        },
        "s3": {
          "$ref": "#/$defs/ClusterS3"
        }
      },
      "additionalProperties": false,
      "required": [
        "pbs",
        "s3"
      ]
    },
    "ClusterConfig": {
      "type": "object",
      "properties": {
        "backup": {
          "$ref": "#/$defs/ClusterBackup"
        },
        "cluster": {
          "$ref": "#/$defs/ClusterIdentity"
        },
        "firewall": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proxmox": {
          "$ref": "#/$defs/ProxmoxCluster"
        },
        "workload_profile": {
          "$ref": "#/$defs/WorkloadProfile"
        }
      },
      "additionalProperties": false,
      "required": [
        "cluster",
        "proxmox",
        "workload_profile",
        "backup"
      ]
    },
    "ClusterIdentity": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "environment"
      ]
    },
    "ClusterPbs": {
      "type": "object",
      "properties": {
        "deployment": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "deployment",
        "endpoint"
      ]
    },
    "ClusterS3": {
      "type": "object",
      "properties": {
        "configured_in_pbs": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "configured_in_pbs",
        "endpoint"
      ]
    },
    "Count": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        {
          "type": "string"
        }
      ]
    },
    "Cpu": {
      "type": "object",
      "properties": {
        "cores": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sockets": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "sockets",
        "cores"
      ]
    },
    "Datastore": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/DatastoreBackend"
        },
        "bucket": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "garbage_collection_schedule": {
          "type": "string"
        },
        "local_cache_path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "s3_endpoint_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "backend",
        "local_cache_path",
        "garbage_collection_schedule"
      ]
    },
    "DatastoreBackend": {
      "type": "string",
      "enum": [
        "local",
        "s3"
      ]
    },
    "Disk": {
      "type": "object",
      "properties": {
        "size_gb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage",
        "size_gb"
      ]
    },
    "Dns": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string"
        },
        "servers": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "search"
      ]
    },
    "Efi": {
      "type": "object",
      "properties": {
        "pre_enrolled_keys": {
          "type": "boolean"
        },
        "storage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "storage",
        "pre_enrolled_keys"
      ]
    },
    "FirewallAction": {
      "type": "string",
      "enum": [
        "ACCEPT",
        "DROP",
        "REJECT",
        "RETURN"
      ]
    },
    "FirewallAlias": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "network"
      ]
    },
    "FirewallDirection": {
      "type": "string",
      "enum": [
        "IN",
        "OUT",
        "GROUP"
      ]
    },
    "FirewallIpSet": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallIpSetEntry"
          }
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "FirewallIpSetEntry": {
      "type": "object",
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "network": {
          "type": "string"
        },
        "nomatch": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "network"
      ]
    },
    "FirewallLogLevel": {
      "type": "string",
      "enum": [
        "nolog",
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug"
      ]
    },
    "FirewallPolicy": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallAlias"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "ip_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallIpSet"
          }
        },
        "log_level_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallLogLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        },
        "security_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FirewallSecurityGroup"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "FirewallProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp",
        "icmpv6",
        "esp",
        "ah"
      ]
    },
    "FirewallRule": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/FirewallAction"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "destination_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "direction": {
          "$ref": "#/$defs/FirewallDirection"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "interface": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "log": {
          "$ref": "#/$defs/FirewallLogLevel",
          "default": "nolog"
        },
        "macro_name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallProtocol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "source_port": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "direction",
        "action"
      ]
    },
    "FirewallSecurityGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FirewallRule"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Guests": {
      "type": "object",
      "properties": {
        "lxcs": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^\\d+$": {
              "$ref": "#/$defs/Lxc"
            }
          }
        },
        "node": {
          "type": "string"
        },
        "vms": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^\\d+$": {
              "$ref": "#/$defs/Vm"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "node"
      ]
    },
    "HostMount": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "required",
        "purpose"
      ]
    },
    "Interface": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/$defs/AddressMethod"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "method"
      ]
    },
    "Lxc": {
      "type": "object",
      "properties": {
        "bind_mounts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/BindMount"
          }
        },
        "cores": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "firewall": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hostname": {
          "type": "string"
        },
        "memory_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "networks": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Nic"
          }
        },
        "options": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "os": {
          "type": "string"
        },
        "rootfs": {
          "$ref": "#/$defs/Disk"
        },
        "start": {
          "$ref": "#/$defs/Start"
        },
        "swap_mb": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unprivileged": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "hostname",
        "os",
        "unprivileged",
        "cores",
        "memory_mb",
        "swap_mb",
        "rootfs",
        "start"
      ]
    },
    "Network": {
      "type": "object",
      "properties": {
        "bridges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bridge"
          }
        },
        "dns": {
          "$ref": "#/$defs/Dns"
        },
        "host": {
          "type": "string"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interface"
          }
        },
        "management_address": {
          "type": "string"
        },
        "management_gateway": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host",
        "management_address",
        "management_gateway",
        "dns",
        "interfaces",
        "bridges"
      ]
    },
    "Nic": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "string"
        },
        "firewall": {
          "type": "boolean",
          "default": false
        },
        "gateway4": {
          "type": [
            "string",
            "null"
          ]
        },
        "gateway6": {
          "type": [
            "string",
            "null"
          ]
        },
        "ipv4": {
          "type": "string"
        },
        "ipv6": {
          "type": [
            "string",
            "null"
          ]
        },
        "mac": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "mac",
        "bridge",
        "ipv4"
      ]
    },
    "NodeConfig": {
      "type": "object",
      "properties": {
        "firewall": {
          "anyOf": [
            {
              "$ref": "#/$defs/FirewallPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "node": {
          "$ref": "#/$defs/NodeIdentity"
        },
        "storage_topology": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StorageTopology"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "node",
        "storage_topology"
      ]
    },
    "NodeIdentity": {
      "type": "object",
      "properties": {
        "kernel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pve_version": {
          "type": "string"
        },
        "standalone": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "standalone",
        "pve_version",
        "kernel"
      ]
    },
    "PbsBackup": {
      "type": "object",
      "properties": {
        "datastore": {
          "anyOf": [
            {
              "$ref": "#/$defs/Datastore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoint": {
          "type": "string"
        },
        "guest": {
          "$ref": "#/$defs/BackupGuest"
        },
        "jobs": {
          "$ref": "#/$defs/BackupJobs"
        },
        "s3_endpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/S3Endpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "endpoint",
        "version",
        "guest",
        "jobs"
      ]
    },
    "PbsBootstrap": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "cache_path": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        },
        "lxc_template": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": "string"
        },
        "s3_endpoint_id": {
          "type": "string"
        },
        "storage_attached_to_pve": {
          "type": "boolean"
        },
        "vmid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "vmid",
        "datastore",
        "cache_path",
        "s3_endpoint_id",
        "bucket",
        "region",
        "storage_attached_to_pve"
      ]
    },
    "Persistence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "Pool": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mountpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sparse": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "zpool": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type",
